{
  "name": "playwright-serenity-screenplay-framework",
  "version": "1.0.0",
  "description": "Framework de automatización de pruebas con Playwright, Serenity/JS, Cucumber y patrón Screenplay",
  "main": "cucumber.js",
  "scripts": {
    "clean": "rimraf target/ .serenity/ test-results/",
    "test": "cucumber-js --tags @orangehrm",
    "test:ui": "cucumber-js --tags \"@ui\"",
    "test:api": "cucumber-js --tags \"@api\"",
    "test:report": "serenity-bdd run",
    "test:all": "npm run clean && npm test && npm run test:report"
  },
  "keywords": [
    "playwright",
    "serenity-js",
    "screenplay-pattern",
    "cucumber",
    "bdd",
    "automation",
    "testing"
  ],
  "author": "Dario",
  "license": "ISC",
  "dependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@serenity-js/assertions": "^3.33.0",
    "@serenity-js/console-reporter": "^3.33.0",
    "@serenity-js/core": "^3.33.0",
    "@serenity-js/cucumber": "^3.33.0",
    "@serenity-js/playwright": "^3.33.0",
    "@serenity-js/rest": "^3.33.0",
    "@serenity-js/serenity-bdd": "^3.33.0",
    "@serenity-js/web": "^3.33.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}